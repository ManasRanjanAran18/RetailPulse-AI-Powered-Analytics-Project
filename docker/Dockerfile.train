# Full training image: Prophet + TensorFlow + MLflow + Optuna + notebooks.
# Build from the repo root:  docker build -f docker/Dockerfile.train -t retailpulse-train .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 TF_CPP_MIN_LOG_LEVEL=3

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-full.txt ./
RUN pip install -r requirements-full.txt

COPY . .

# Default job: rebuild all artifacts and log every run to MLflow
CMD ["python", "scripts/run_pipeline.py", "--mlflow"]
